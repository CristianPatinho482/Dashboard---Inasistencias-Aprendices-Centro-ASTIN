table DIM_FICHA

	column FichaID
		dataType: string
		summarizeBy: none
		sourceColumn: FichaID

	column ProgramaID
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: ProgramaID

	column InstructorPrincipal
		dataType: string
		summarizeBy: none
		sourceColumn: InstructorPrincipal

	column TotalInstructores
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: TotalInstructores

	column Jornada
		dataType: string
		summarizeBy: none
		sourceColumn: Jornada

	column Modalidad
		dataType: string
		summarizeBy: none
		sourceColumn: Modalidad

	column Sede
		dataType: string
		summarizeBy: none
		sourceColumn: Sede

	column CentroCosto
		dataType: string
		summarizeBy: none
		sourceColumn: CentroCosto

	column LineaFormacion
		dataType: string
		summarizeBy: none
		sourceColumn: LineaFormacion

	column EstadoFicha
		dataType: string
		summarizeBy: none
		sourceColumn: EstadoFicha

	column DiasSinNovedad
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: DiasSinNovedad

	column Aprendices
		dataType: int64
		formatString: #,##0
		summarizeBy: none
		sourceColumn: Aprendices

	column Inasistencias
		dataType: int64
		formatString: #,##0
		summarizeBy: none
		sourceColumn: Inasistencias

	column Horas
		dataType: int64
		formatString: #,##0
		summarizeBy: none
		sourceColumn: Horas

	column HorasNoJustificadas
		dataType: int64
		formatString: #,##0
		summarizeBy: none
		sourceColumn: HorasNoJustificadas

	column PctHorasNoJust
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: PctHorasNoJust

	column HorasPorAprendiz
		dataType: double
		formatString: #,##0.0
		summarizeBy: none
		sourceColumn: HorasPorAprendiz

	column InasPorAprendiz
		dataType: double
		formatString: #,##0.0
		summarizeBy: none
		sourceColumn: InasPorAprendiz

	column MuestraSuficiente
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: MuestraSuficiente

	column IndiceRiesgoCorte
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: IndiceRiesgoCorte

	column NivelRiesgoCorte
		dataType: string
		summarizeBy: none
		sourceColumn: NivelRiesgoCorte

	column PrimeraNovedad
		dataType: dateTime
		formatString: yyyy-MM-dd
		summarizeBy: none
		sourceColumn: PrimeraNovedad

	column UltimaNovedad
		dataType: dateTime
		formatString: yyyy-MM-dd
		summarizeBy: none
		sourceColumn: UltimaNovedad

	partition DIM_FICHA = m
		mode: import
		source =
			let
				Origen = let Coincidencia = Table.SelectRows(ArchivosSharePoint, each [Folder Path] = RutaDatosSharePoint and [Name] = "DIM_FICHA.csv"), Binario = if Table.RowCount(Coincidencia) = 0 then error "No se encontró DIM_FICHA.csv en SharePoint." else Coincidencia{0}[Content] in Csv.Document(Binario,[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				Tipos = Table.TransformColumnTypes(Encabezados,{{"FichaID", type text}, {"ProgramaID", type text}, {"InstructorPrincipal", type text}, {"TotalInstructores", Int64.Type}, {"Jornada", type text}, {"Modalidad", type text}, {"Sede", type text}, {"CentroCosto", type text}, {"LineaFormacion", type text}, {"EstadoFicha", type text}, {"DiasSinNovedad", Int64.Type}, {"Aprendices", Int64.Type}, {"Inasistencias", Int64.Type}, {"Horas", Int64.Type}, {"HorasNoJustificadas", Int64.Type}, {"MuestraSuficiente", Int64.Type}, {"NivelRiesgoCorte", type text}, {"PrimeraNovedad", type date}, {"UltimaNovedad", type date}}),
				Decimales = Table.TransformColumns(Tipos,{
					{"PctHorasNoJust", each if _ = null then null else if Text.Trim(_) = "" then null else Number.FromText(Text.Trim(_), "en-US"), type number},
					{"HorasPorAprendiz", each if _ = null then null else if Text.Trim(_) = "" then null else Number.FromText(Text.Trim(_), "en-US"), type number},
					{"InasPorAprendiz", each if _ = null then null else if Text.Trim(_) = "" then null else Number.FromText(Text.Trim(_), "en-US"), type number},
					{"IndiceRiesgoCorte", each if _ = null then null else if Text.Trim(_) = "" then null else Number.FromText(Text.Trim(_), "en-US"), type number}
				})
			in
				Decimales
