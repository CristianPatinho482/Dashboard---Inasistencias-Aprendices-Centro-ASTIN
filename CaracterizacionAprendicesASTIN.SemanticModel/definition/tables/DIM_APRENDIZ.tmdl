	partition DIM_APRENDIZ = m
		mode: import
		source =
				let
					Origen = Csv.Document(File.Contents(RutaDatos & "\DIM_APRENDIZ.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
					Tipos = Table.TransformColumnTypes(Encabezados,{{"AprendizID", type text}, {"TipoDocumento", type text}, {"DocumentoEnmascarado", type text}, {"Iniciales", type text}, {"FichaPrincipal", type text}, {"ProgramaPrincipal", type text}, {"Inasistencias", Int64.Type}, {"Horas", Int64.Type}, {"Justificadas", Int64.Type}, {"NoJustificadas", Int64.Type}, {"Retardos", Int64.Type}, {"HorasNoJustificadas", Int64.Type}, {"NivelRiesgo", type text}, {"EstadoAsistencia", type text}, {"EsReincidente", Int64.Type}, {"EsReincidenteAlto", Int64.Type}, {"AlertaDesercion", Int64.Type}, {"MotivoAlertaDesercion", type text}, {"DiasDesdeUltimaNovedad", Int64.Type}, {"PrimeraNovedad", type date}, {"UltimaNovedad", type date}}),
					Decimales = Table.TransformColumns(Tipos,{
						{"ScoreRiesgo", each if _ = null then null else if Text.Trim(_) = "" then null else Number.FromText(Text.Trim(_), "en-US"), type number}
					})
				in
					Decimales

