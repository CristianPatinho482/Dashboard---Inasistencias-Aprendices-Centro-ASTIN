table DIM_APRENDIZ

	column AprendizID
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: AprendizID

	column TipoDocumento
		dataType: string
		summarizeBy: none
		sourceColumn: TipoDocumento

	column DocumentoEnmascarado
		dataType: string
		summarizeBy: none
		sourceColumn: DocumentoEnmascarado

	column Iniciales
		dataType: string
		summarizeBy: none
		sourceColumn: Iniciales

	column NombreCompleto
		dataType: string
		summarizeBy: none
		sourceColumn: NombreCompleto

	column FichaPrincipal
		dataType: string
		summarizeBy: none
		sourceColumn: FichaPrincipal

	column ProgramaPrincipal
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: ProgramaPrincipal

	column Inasistencias
		dataType: int64
		formatString: #,##0
		summarizeBy: none
		sourceColumn: Inasistencias

	column Horas
		dataType: int64
		formatString: #,##0
		summarizeBy: none
		sourceColumn: Horas

	column Justificadas
		dataType: int64
		formatString: #,##0
		summarizeBy: none
		sourceColumn: Justificadas

	column NoJustificadas
		dataType: int64
		formatString: #,##0
		summarizeBy: none
		sourceColumn: NoJustificadas

	column Retardos
		dataType: int64
		formatString: #,##0
		summarizeBy: none
		sourceColumn: Retardos

	column HorasNoJustificadas
		dataType: int64
		formatString: #,##0
		summarizeBy: none
		sourceColumn: HorasNoJustificadas

	column ScoreRiesgo
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: ScoreRiesgo

	column NivelRiesgo
		dataType: string
		summarizeBy: none
		sourceColumn: NivelRiesgo

	column EstadoAsistencia
		dataType: string
		summarizeBy: none
		sourceColumn: EstadoAsistencia

	column EsReincidente
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: EsReincidente

	column EsReincidenteAlto
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: EsReincidenteAlto

	column AlertaDesercion
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: AlertaDesercion

	column MotivoAlertaDesercion
		dataType: string
		summarizeBy: none
		sourceColumn: MotivoAlertaDesercion

	column DiasDesdeUltimaNovedad
		dataType: int64
		formatString: #,##0
		summarizeBy: none
		sourceColumn: DiasDesdeUltimaNovedad

	column PrimeraNovedad
		dataType: dateTime
		formatString: yyyy-MM-dd
		summarizeBy: none
		sourceColumn: PrimeraNovedad

	column UltimaNovedad
		dataType: dateTime
		formatString: yyyy-MM-dd
		summarizeBy: none
		sourceColumn: UltimaNovedad

	column EsTopRiesgo =
		IF ( RANKX ( ALL ( DIM_APRENDIZ[AprendizID] ), DIM_APRENDIZ[ScoreRiesgo], , DESC, Dense ) <= 15, 1, 0)
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none

	partition DIM_APRENDIZ = m
		mode: import
		source =
			let
				Origen = let Coincidencia = Table.SelectRows(ArchivosSharePoint, each [Folder Path] = RutaDatosSharePoint and [Name] = "DIM_APRENDIZ.csv"), Binario = if Table.RowCount(Coincidencia) = 0 then error "No se encontró DIM_APRENDIZ.csv en SharePoint." else Coincidencia{0}[Content] in Csv.Document(Binario,[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				Tipos = Table.TransformColumnTypes(Encabezados,{{"AprendizID", type text}, {"TipoDocumento", type text}, {"DocumentoEnmascarado", type text}, {"Iniciales", type text}, {"FichaPrincipal", type text}, {"ProgramaPrincipal", type text}, {"Inasistencias", Int64.Type}, {"Horas", Int64.Type}, {"Justificadas", Int64.Type}, {"NoJustificadas", Int64.Type}, {"Retardos", Int64.Type}, {"HorasNoJustificadas", Int64.Type}, {"NivelRiesgo", type text}, {"EstadoAsistencia", type text}, {"EsReincidente", Int64.Type}, {"EsReincidenteAlto", Int64.Type}, {"AlertaDesercion", Int64.Type}, {"MotivoAlertaDesercion", type text}, {"DiasDesdeUltimaNovedad", Int64.Type}, {"PrimeraNovedad", type date}, {"UltimaNovedad", type date}}),
				Decimales = Table.TransformColumns(Tipos,{
					{"ScoreRiesgo", each if _ = null then null else if Text.Trim(_) = "" then null else Number.FromText(Text.Trim(_), "en-US"), type number}
				}),
				SinIdentidad = Table.AddColumn(Decimales, "NombreCompleto", each null, type text)
			in
				SinIdentidad
