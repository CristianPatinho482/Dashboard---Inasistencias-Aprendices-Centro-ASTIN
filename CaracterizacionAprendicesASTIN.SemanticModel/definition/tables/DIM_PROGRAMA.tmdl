table DIM_PROGRAMA

	column ProgramaID
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: ProgramaID

	column NombrePrograma
		dataType: string
		summarizeBy: none
		sourceColumn: NombrePrograma

	column NombreOriginal
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: NombreOriginal

	column LineaFormacion
		dataType: string
		summarizeBy: none
		sourceColumn: LineaFormacion

	column TipoFormacion
		dataType: string
		summarizeBy: none
		sourceColumn: TipoFormacion

	column CentroCosto
		dataType: string
		summarizeBy: none
		sourceColumn: CentroCosto

	column CentroFormacion
		dataType: string
		summarizeBy: none
		sourceColumn: CentroFormacion

	column Regional
		dataType: string
		summarizeBy: none
		sourceColumn: Regional

	column NivelFormacion
		dataType: string
		summarizeBy: none
		sourceColumn: NivelFormacion

	column Aprendices
		dataType: int64
		formatString: #,##0
		summarizeBy: none
		sourceColumn: Aprendices

	column Inasistencias
		dataType: int64
		formatString: #,##0
		summarizeBy: none
		sourceColumn: Inasistencias

	column Horas
		dataType: int64
		formatString: #,##0
		summarizeBy: none
		sourceColumn: Horas

	column HorasNoJustificadas
		dataType: int64
		formatString: #,##0
		summarizeBy: none
		sourceColumn: HorasNoJustificadas

	column PctHorasNoJust
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: PctHorasNoJust

	column HorasPorAprendiz
		dataType: double
		formatString: #,##0.0
		summarizeBy: none
		sourceColumn: HorasPorAprendiz

	column InasPorAprendiz
		dataType: double
		formatString: #,##0.0
		summarizeBy: none
		sourceColumn: InasPorAprendiz

	column MuestraSuficiente
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: MuestraSuficiente

	column IndiceRiesgoCorte
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: IndiceRiesgoCorte

	column NivelRiesgoCorte
		dataType: string
		summarizeBy: none
		sourceColumn: NivelRiesgoCorte

	column RankingHoras
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: RankingHoras

	column PrimeraNovedad
		dataType: dateTime
		formatString: yyyy-MM-dd
		summarizeBy: none
		sourceColumn: PrimeraNovedad

	column UltimaNovedad
		dataType: dateTime
		formatString: yyyy-MM-dd
		summarizeBy: none
		sourceColumn: UltimaNovedad

	partition DIM_PROGRAMA = m
		mode: import
		source =
			let
				Origen = let Coincidencia = Table.SelectRows(ArchivosSharePoint, each [Folder Path] = RutaDatosSharePoint and [Name] = "DIM_PROGRAMA.csv"), Binario = if Table.RowCount(Coincidencia) = 0 then error "No se encontró DIM_PROGRAMA.csv en SharePoint." else Coincidencia{0}[Content] in Csv.Document(Binario,[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				Tipos = Table.TransformColumnTypes(Encabezados,{{"ProgramaID", type text}, {"NombrePrograma", type text}, {"NombreOriginal", type text}, {"LineaFormacion", type text}, {"TipoFormacion", type text}, {"CentroCosto", type text}, {"CentroFormacion", type text}, {"Regional", type text}, {"NivelFormacion", type text}, {"Aprendices", Int64.Type}, {"Inasistencias", Int64.Type}, {"Horas", Int64.Type}, {"HorasNoJustificadas", Int64.Type}, {"MuestraSuficiente", Int64.Type}, {"NivelRiesgoCorte", type text}, {"RankingHoras", Int64.Type}, {"PrimeraNovedad", type date}, {"UltimaNovedad", type date}}),
				Decimales = Table.TransformColumns(Tipos,{
					{"PctHorasNoJust", each if _ = null then null else if Text.Trim(_) = "" then null else Number.FromText(Text.Trim(_), "en-US"), type number},
					{"HorasPorAprendiz", each if _ = null then null else if Text.Trim(_) = "" then null else Number.FromText(Text.Trim(_), "en-US"), type number},
					{"InasPorAprendiz", each if _ = null then null else if Text.Trim(_) = "" then null else Number.FromText(Text.Trim(_), "en-US"), type number},
					{"IndiceRiesgoCorte", each if _ = null then null else if Text.Trim(_) = "" then null else Number.FromText(Text.Trim(_), "en-US"), type number}
				})
			in
				Decimales
