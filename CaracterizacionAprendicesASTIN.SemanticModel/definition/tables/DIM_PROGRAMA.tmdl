	partition DIM_PROGRAMA = m
		mode: import
		source =
				let
					Origen = Csv.Document(File.Contents(RutaDatos & "\DIM_PROGRAMA.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
					Tipos = Table.TransformColumnTypes(Encabezados,{{"ProgramaID", type text}, {"NombrePrograma", type text}, {"NombreOriginal", type text}, {"LineaFormacion", type text}, {"TipoFormacion", type text}, {"CentroCosto", type text}, {"CentroFormacion", type text}, {"Regional", type text}, {"NivelFormacion", type text}, {"Aprendices", Int64.Type}, {"Inasistencias", Int64.Type}, {"Horas", Int64.Type}, {"HorasNoJustificadas", Int64.Type}, {"MuestraSuficiente", Int64.Type}, {"NivelRiesgoCorte", type text}, {"RankingHoras", Int64.Type}, {"PrimeraNovedad", type date}, {"UltimaNovedad", type date}}),
					Decimales = Table.TransformColumns(Tipos,{
						{"PctHorasNoJust", each if _ = null then null else if Text.Trim(_) = "" then null else Number.FromText(Text.Trim(_), "en-US"), type number},
						{"HorasPorAprendiz", each if _ = null then null else if Text.Trim(_) = "" then null else Number.FromText(Text.Trim(_), "en-US"), type number},
						{"InasPorAprendiz", each if _ = null then null else if Text.Trim(_) = "" then null else Number.FromText(Text.Trim(_), "en-US"), type number},
						{"IndiceRiesgoCorte", each if _ = null then null else if Text.Trim(_) = "" then null else Number.FromText(Text.Trim(_), "en-US"), type number}
					})
				in
					Decimales

