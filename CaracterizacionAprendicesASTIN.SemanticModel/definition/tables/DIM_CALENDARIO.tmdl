table DIM_CALENDARIO
	dataCategory: Time

	column Fecha
		dataType: dateTime
		isKey
		formatString: yyyy-MM-dd
		summarizeBy: none
		sourceColumn: Fecha

	column Anio
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Anio

	column Trimestre
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Trimestre

	column Mes
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Mes

	column NombreMes
		dataType: string
		summarizeBy: none
		sortByColumn: Mes
		sourceColumn: NombreMes

	column MesCorto
		dataType: string
		summarizeBy: none
		sortByColumn: Mes
		sourceColumn: MesCorto

	column AnioMes
		dataType: string
		summarizeBy: none
		sourceColumn: AnioMes

	column EtiquetaMes
		dataType: string
		summarizeBy: none
		sortByColumn: OrdenAnioMes
		sourceColumn: EtiquetaMes

	column OrdenAnioMes
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: OrdenAnioMes

	column SemanaISO
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: SemanaISO

	column InicioSemana
		dataType: dateTime
		formatString: yyyy-MM-dd
		summarizeBy: none
		sourceColumn: InicioSemana

	column Dia
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Dia

	column NombreDia
		dataType: string
		summarizeBy: none
		sourceColumn: NombreDia

	column EsFinSemana
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: EsFinSemana

	column Periodo
		dataType: string
		summarizeBy: none
		sourceColumn: Periodo

	column EsMesCompleto
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: EsMesCompleto

	column FechaCorte
		dataType: dateTime
		formatString: yyyy-MM-dd
		summarizeBy: none
		sourceColumn: FechaCorte

	column DiasDesdeCorte
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: DiasDesdeCorte

	column FechaKey
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: FechaKey

	partition DIM_CALENDARIO = m
		mode: import
		source =
			let
				Origen = let Coincidencia = Table.SelectRows(ArchivosSharePoint, each [Folder Path] = RutaDatosSharePoint and [Name] = "DIM_CALENDARIO.csv"), Binario = if Table.RowCount(Coincidencia) = 0 then error "No se encontró DIM_CALENDARIO.csv en SharePoint." else Coincidencia{0}[Content] in Csv.Document(Binario,[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				Tipos = Table.TransformColumnTypes(Encabezados,{{"Fecha", type date}, {"Anio", Int64.Type}, {"Trimestre", Int64.Type}, {"Mes", Int64.Type}, {"NombreMes", type text}, {"MesCorto", type text}, {"AnioMes", type text}, {"EtiquetaMes", type text}, {"OrdenAnioMes", Int64.Type}, {"SemanaISO", Int64.Type}, {"InicioSemana", type date}, {"Dia", Int64.Type}, {"NombreDia", type text}, {"EsFinSemana", Int64.Type}, {"Periodo", type text}, {"EsMesCompleto", Int64.Type}, {"FechaCorte", type date}, {"DiasDesdeCorte", Int64.Type}, {"FechaKey", Int64.Type}})
			in
				Tipos
