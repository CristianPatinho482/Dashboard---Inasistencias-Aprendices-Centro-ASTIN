	measure 'Fichas en riesgo medio' = ```
			CALCULATE ( DISTINCTCOUNT ( FACT_INASISTENCIAS[FichaID] ), DIM_FICHA[NivelRiesgoCorte] = "Medio" )
			```
		formatString: #,##0
		displayFolder: 02 Riesgo

	measure 'Fichas muestra insuficiente' = ```
			CALCULATE ( DISTINCTCOUNT ( FACT_INASISTENCIAS[FichaID] ), DIM_FICHA[NivelRiesgoCorte] = "Muestra baja" )
			```
		formatString: #,##0
		displayFolder: 02 Riesgo

	measure '% fichas en riesgo alto' = ```
			DIVIDE ( [Fichas en riesgo alto], [Fichas con inasistencias] )
			```
		formatString: 0.0%
		displayFolder: 02 Riesgo

	measure 'Programas en riesgo medio' = ```
			CALCULATE ( DISTINCTCOUNT ( FACT_INASISTENCIAS[ProgramaID] ), DIM_PROGRAMA[NivelRiesgoCorte] = "Medio" )
			```
		formatString: #,##0
		displayFolder: 02 Riesgo

	measure 'Programas muestra insuficiente' = ```
			CALCULATE ( DISTINCTCOUNT ( FACT_INASISTENCIAS[ProgramaID] ), DIM_PROGRAMA[NivelRiesgoCorte] = "Muestra baja" )
			```
		formatString: #,##0
		displayFolder: 02 Riesgo

	measure 'Índice de riesgo promedio de fichas' = ```
			AVERAGEX ( VALUES ( FACT_INASISTENCIAS[FichaID] ), CALCULATE ( MAX ( DIM_FICHA[IndiceRiesgoCorte] ) ) )
			```
		formatString: 0.0
		displayFolder: 02 Riesgo

	measure 'Índice de riesgo promedio de programas' = ```
			AVERAGEX ( VALUES ( FACT_INASISTENCIAS[ProgramaID] ), CALCULATE ( MAX ( DIM_PROGRAMA[IndiceRiesgoCorte] ) ) )
			```
		formatString: 0.0
		displayFolder: 02 Riesgo

	measure 'Máximo índice de riesgo de ficha' = ```
			MAXX ( VALUES ( FACT_INASISTENCIAS[FichaID] ), CALCULATE ( MAX ( DIM_FICHA[IndiceRiesgoCorte] ) ) )
			```
		formatString: 0.0
		displayFolder: 02 Riesgo

	measure 'Ficha crítica principal' = ```
			VAR Ranking = ADDCOLUMNS ( VALUES ( FACT_INASISTENCIAS[FichaID] ), "@Score", CALCULATE ( MAX ( DIM_FICHA[IndiceRiesgoCorte] ) ) )
			VAR Top1 = TOPN ( 1, FILTER ( Ranking, NOT ISBLANK ( [@Score] ) ), [@Score], DESC )
			RETURN CONCATENATEX ( Top1, FACT_INASISTENCIAS[FichaID], ", " )
			```
		displayFolder: 02 Riesgo

	measure 'Programa crítico principal' = ```
			VAR Ranking = ADDCOLUMNS ( VALUES ( FACT_INASISTENCIAS[ProgramaID] ), "@Score", CALCULATE ( MAX ( DIM_PROGRAMA[IndiceRiesgoCorte] ) ) )
			VAR Top1 = TOPN ( 1, FILTER ( Ranking, NOT ISBLANK ( [@Score] ) ), [@Score], DESC )
			RETURN CONCATENATEX ( Top1, DIM_PROGRAMA[NombrePrograma], ", " )
			```
		displayFolder: 02 Riesgo

	measure 'Aprendices en riesgo alto' = ```
			CALCULATE ( [Aprendices con inasistencias], FACT_INASISTENCIAS[NivelRiesgoAprendiz] = "Alto" )
			```
		formatString: #,##0
		displayFolder: 02 Riesgo

	measure '% aprendices en riesgo alto' = ```
			DIVIDE ( [Aprendices en riesgo alto], [Aprendices con inasistencias] )
			```
		formatString: 0.0%
		displayFolder: 02 Riesgo

	measure 'Aprendices en riesgo medio' = ```
			CALCULATE ( [Aprendices con inasistencias], FACT_INASISTENCIAS[NivelRiesgoAprendiz] = "Medio" )
			```
		formatString: #,##0
		displayFolder: 02 Riesgo

	measure 'Aprendices en riesgo bajo' = ```
			CALCULATE ( [Aprendices con inasistencias], FACT_INASISTENCIAS[NivelRiesgoAprendiz] = "Bajo" )
			```
		formatString: #,##0
		displayFolder: 02 Riesgo

	measure 'Horas no justificadas por aprendiz' = ```
			DIVIDE ( [Horas no justificadas], [Aprendices con inasistencias] )
			```
		formatString: #,##0.0
		displayFolder: 02 Riesgo

	measure 'Casos con alerta por texto' = ```
			CALCULATE ( [Aprendices con inasistencias], FACT_INASISTENCIAS[EsAlertaDesercionAprendiz] = 1, DIM_APRENDIZ[MotivoAlertaDesercion] IN { "Texto de retiro/deserción", "Texto y patrón" } )
			```
		formatString: #,##0
		displayFolder: 02 Riesgo

	measure 'Casos con alerta por patrón' = ```
			CALCULATE ( [Aprendices con inasistencias], FACT_INASISTENCIAS[EsAlertaDesercionAprendiz] = 1, DIM_APRENDIZ[MotivoAlertaDesercion] IN { "Patrón de ausencias", "Texto y patrón" } )
			```
		formatString: #,##0
		displayFolder: 02 Riesgo

	measure '% aprendices con alerta' = ```
			DIVIDE ( [Casos posible deserción], [Aprendices con inasistencias] )
			```
		formatString: 0.0%
		displayFolder: 02 Riesgo

	measure 'Horas no justificadas en fichas de alto riesgo' = ```
			CALCULATE ( [Horas no justificadas], DIM_FICHA[NivelRiesgoCorte] = "Alto" )
			```
		formatString: #,##0
		displayFolder: 02 Riesgo

	measure 'Aprendices afectados en fichas de alto riesgo' = ```
			CALCULATE ( [Aprendices con inasistencias], DIM_FICHA[NivelRiesgoCorte] = "Alto" )
			```
		formatString: #,##0
		displayFolder: 02 Riesgo

	measure 'Horas promedio por aprendiz' = ```
			DIVIDE ( [Total horas perdidas], [Aprendices con inasistencias] )
			```
		formatString: #,##0.0
		displayFolder: 03 Aprendices

	measure 'Inasistencias promedio por aprendiz' = ```
			DIVIDE ( [Total inasistencias], [Aprendices con inasistencias] )
			```
		formatString: #,##0.0
		displayFolder: 03 Aprendices

	measure 'Mediana de inasistencias por aprendiz' = ```
			MEDIANX ( VALUES ( FACT_INASISTENCIAS[AprendizID] ), CALCULATE ( [Total inasistencias] ) )
			```
		formatString: #,##0.0
		displayFolder: 03 Aprendices

	measure 'Máximo de inasistencias por aprendiz' = ```
			MAXX ( VALUES ( FACT_INASISTENCIAS[AprendizID] ), CALCULATE ( [Total inasistencias] ) )
			```
		formatString: #,##0
		displayFolder: 03 Aprendices

	measure 'Aprendices reincidentes' = ```
			CALCULATE ( [Aprendices con inasistencias], FACT_INASISTENCIAS[EsReincidenteAprendiz] = 1 )
			```
		formatString: #,##0
		displayFolder: 03 Aprendices

