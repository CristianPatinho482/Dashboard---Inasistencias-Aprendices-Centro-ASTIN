	measure 'Inasistencias justificadas' = ```
			CALCULATE ( [Total inasistencias], FACT_INASISTENCIAS[EsJustificada] = 1 )
			```
		formatString: #,##0
		displayFolder: 01 Inasistencias

	measure 'Inasistencias no justificadas' = ```
			CALCULATE ( [Total inasistencias], FACT_INASISTENCIAS[EsNoJustificada] = 1 )
			```
		formatString: #,##0
		displayFolder: 01 Inasistencias

	measure 'Inasistencias sin información' = ```
			CALCULATE ( [Total inasistencias], FACT_INASISTENCIAS[EsSinInformacion] = 1 )
			```
		formatString: #,##0
		displayFolder: 01 Inasistencias

	measure '% inasistencias no justificadas' = ```
