	measure 'Horas último mes' =
			VAR FechaMax = CALCULATE ( MAX ( FACT_INASISTENCIAS[Fecha] ), REMOVEFILTERS ( DIM_CALENDARIO ) )
			VAR InicioMes = DATE ( YEAR ( FechaMax ), MONTH ( FechaMax ), 1 )
			RETURN CALCULATE ( [Total horas perdidas], DIM_CALENDARIO[Fecha] >= InicioMes && DIM_CALENDARIO[Fecha] <= FechaMax )
		formatString: #,##0
		displayFolder: 04 Tendencias
		lineageTag: dafecdcd-4bf5-4815-8bb1-48b7a59d5ed2

	measure 'Horas mes anterior' =
			VAR FechaMax = CALCULATE ( MAX ( FACT_INASISTENCIAS[Fecha] ), REMOVEFILTERS ( DIM_CALENDARIO ) )
			VAR InicioMes = DATE ( YEAR ( FechaMax ), MONTH ( FechaMax ), 1 )
			VAR InicioAnterior = EDATE ( InicioMes, -1 )
			RETURN CALCULATE ( [Total horas perdidas], DIM_CALENDARIO[Fecha] >= InicioAnterior && DIM_CALENDARIO[Fecha] < InicioMes )
		formatString: #,##0
		displayFolder: 04 Tendencias
		lineageTag: f03f119b-1261-48ab-bc5b-9a28827d01f5

	measure 'Variación % horas mes' = DIVIDE ( [Horas último mes] - [Horas mes anterior], [Horas mes anterior] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 04 Tendencias
		lineageTag: 629391f8-4a76-4240-87a2-d71da1b85200

	measure 'Horas YTD' =
			VAR FechaMax = CALCULATE ( MAX ( FACT_INASISTENCIAS[Fecha] ), REMOVEFILTERS ( DIM_CALENDARIO ) )
			RETURN CALCULATE ( [Total horas perdidas], DATESYTD ( DIM_CALENDARIO[Fecha] ), DIM_CALENDARIO[Fecha] <= FechaMax )
		formatString: #,##0
		displayFolder: 04 Tendencias
		lineageTag: 2d5166fd-8af5-4bf6-8125-7ac5ef3e6509

	measure 'Inasistencias último mes' =
			VAR FechaMax = CALCULATE ( MAX ( FACT_INASISTENCIAS[Fecha] ), REMOVEFILTERS ( DIM_CALENDARIO ) )
			VAR InicioMes = DATE ( YEAR ( FechaMax ), MONTH ( FechaMax ), 1 )
			RETURN CALCULATE ( [Total inasistencias], DIM_CALENDARIO[Fecha] >= InicioMes && DIM_CALENDARIO[Fecha] <= FechaMax )
		formatString: #,##0
		displayFolder: 04 Tendencias
		lineageTag: be3bb039-4286-4ec5-a767-4696f49f96ed

	measure 'Inasistencias mes anterior' =
			VAR FechaMax = CALCULATE ( MAX ( FACT_INASISTENCIAS[Fecha] ), REMOVEFILTERS ( DIM_CALENDARIO ) )
			VAR InicioMes = DATE ( YEAR ( FechaMax ), MONTH ( FechaMax ), 1 )
			VAR InicioAnterior = EDATE ( InicioMes, -1 )
			RETURN CALCULATE ( [Total inasistencias], DIM_CALENDARIO[Fecha] >= InicioAnterior && DIM_CALENDARIO[Fecha] < InicioMes )
		formatString: #,##0
		displayFolder: 04 Tendencias
		lineageTag: 440699cf-c47c-4a70-842d-1349f3537762

	measure 'Variación % inasistencias mes' = DIVIDE ( [Inasistencias último mes] - [Inasistencias mes anterior], [Inasistencias mes anterior] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 04 Tendencias
		lineageTag: 22f10fdf-a8f7-4ac3-b92f-295c3178e53c

	measure 'Aprendices último mes' =
			VAR FechaMax = CALCULATE ( MAX ( FACT_INASISTENCIAS[Fecha] ), REMOVEFILTERS ( DIM_CALENDARIO ) )
			VAR InicioMes = DATE ( YEAR ( FechaMax ), MONTH ( FechaMax ), 1 )
			RETURN CALCULATE ( [Aprendices con inasistencias], DIM_CALENDARIO[Fecha] >= InicioMes && DIM_CALENDARIO[Fecha] <= FechaMax )
		formatString: #,##0
		displayFolder: 04 Tendencias
		lineageTag: 5a2d74c4-ef3f-4c81-b5da-132c1d4fa19e

	measure 'Horas no justificadas último mes' =
			VAR FechaMax = CALCULATE ( MAX ( FACT_INASISTENCIAS[Fecha] ), REMOVEFILTERS ( DIM_CALENDARIO ) )
			VAR InicioMes = DATE ( YEAR ( FechaMax ), MONTH ( FechaMax ), 1 )
			RETURN CALCULATE ( [Horas no justificadas], DIM_CALENDARIO[Fecha] >= InicioMes && DIM_CALENDARIO[Fecha] <= FechaMax )
		formatString: #,##0
		displayFolder: 04 Tendencias
		lineageTag: 4ed593cf-186e-484b-8987-cf01aed05f5b

	measure '% horas no justificadas último mes' = DIVIDE ( [Horas no justificadas último mes], [Horas último mes] )
		formatString: 0.0%
		displayFolder: 04 Tendencias
		lineageTag: 262387e3-6f42-468a-8ee2-467b22cf7afd

	measure 'Promedio mensual de horas' =
			VAR Meses = FILTER ( VALUES ( DIM_CALENDARIO[AnioMes] ), CALCULATE ( [Total inasistencias] ) > 0 )
			RETURN AVERAGEX ( Meses, CALCULATE ( [Total horas perdidas] ) )
		formatString: #,##0
		displayFolder: 04 Tendencias
		lineageTag: bf197f68-f80e-4793-afcc-4916924257c9

	measure 'Mes con más horas' =
			VAR Meses = ADDCOLUMNS ( FILTER ( VALUES ( DIM_CALENDARIO[EtiquetaMes] ), CALCULATE ( [Total inasistencias] ) > 0 ), "@Horas", CALCULATE ( [Total horas perdidas] ) )
			RETURN MAXX ( TOPN ( 1, Meses, [@Horas], DESC ), DIM_CALENDARIO[EtiquetaMes] )
		displayFolder: 04 Tendencias
		lineageTag: 81500e02-fb0f-49f9-b1e8-040b7db91f1d

	measure 'Horas del mes pico' =
			VAR Meses = ADDCOLUMNS ( FILTER ( VALUES ( DIM_CALENDARIO[EtiquetaMes] ), CALCULATE ( [Total inasistencias] ) > 0 ), "@Horas", CALCULATE ( [Total horas perdidas] ) )
			RETURN MAXX ( TOPN ( 1, Meses, [@Horas], DESC ), [@Horas] )
		formatString: #,##0
		displayFolder: 04 Tendencias
		lineageTag: 358a9a2c-a718-490d-a6c1-76f3ae870d29

	measure 'Promedio móvil 3 meses de horas' =
			VAR FechaMax = CALCULATE ( MAX ( FACT_INASISTENCIAS[Fecha] ), REMOVEFILTERS ( DIM_CALENDARIO ) )
			VAR Fin = EOMONTH ( FechaMax, 0 )
			RETURN CALCULATE ( AVERAGEX ( VALUES ( DIM_CALENDARIO[AnioMes] ), [Total horas perdidas] ), DATESINPERIOD ( DIM_CALENDARIO[Fecha], Fin, -3, MONTH ) )
		formatString: #,##0
		displayFolder: 04 Tendencias
		lineageTag: 1803e4d5-7194-4c78-989c-8ad85bfbef50

