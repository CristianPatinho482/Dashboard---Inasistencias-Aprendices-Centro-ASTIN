	measure 'Top 10 Horas Ficha' =
			VAR Ranking = RANKX ( ALLSELECTED ( DIM_FICHA[FichaID] ), [Total horas perdidas], , DESC, Dense )
			RETURN IF ( NOT ISBLANK ( [Total horas perdidas] ) && Ranking <= 10, [Total horas perdidas] )
		formatString: #,##0
		displayFolder: 01 Inasistencias
		lineageTag: 9cb5ce90-af1a-43c7-9d91-fdec598bb496

	measure 'Top 10 Horas No Justificadas Ficha' =
			VAR Ranking = RANKX ( ALLSELECTED ( DIM_FICHA[FichaID] ), [Horas no justificadas], , DESC, Dense )
			RETURN IF ( NOT ISBLANK ( [Horas no justificadas] ) && Ranking <= 10, [Horas no justificadas] )
		formatString: #,##0
		displayFolder: 01 Inasistencias
		lineageTag: 93325c35-4a22-4c5a-b2c3-442f49d538f4

	measure 'Top 10 Horas Programa' =
			VAR Ranking = RANKX ( ALLSELECTED ( DIM_PROGRAMA[NombrePrograma] ), [Total horas perdidas], , DESC, Dense )
			RETURN IF ( NOT ISBLANK ( [Total horas perdidas] ) && Ranking <= 10, [Total horas perdidas] )
		formatString: #,##0
		displayFolder: 01 Inasistencias
		lineageTag: 3661fef7-521d-456f-9da6-2bc24fa4be5a

	measure 'Top 10 Horas No Justificadas Programa' =
			VAR Ranking = RANKX ( ALLSELECTED ( DIM_PROGRAMA[NombrePrograma] ), [Horas no justificadas], , DESC, Dense )
			RETURN IF ( NOT ISBLANK ( [Horas no justificadas] ) && Ranking <= 10, [Horas no justificadas] )
