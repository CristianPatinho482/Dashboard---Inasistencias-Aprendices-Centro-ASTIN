	measure '% aprendices reincidentes' = ```
			DIVIDE ( [Aprendices reincidentes], [Aprendices con inasistencias] )
			```
		formatString: 0.0%
		displayFolder: 03 Aprendices

	measure 'Aprendices con una sola inasistencia' = ```
			COUNTROWS ( FILTER ( VALUES ( FACT_INASISTENCIAS[AprendizID] ), CALCULATE ( [Total inasistencias] ) = 1 ) )
			```
		formatString: #,##0
		displayFolder: 03 Aprendices

