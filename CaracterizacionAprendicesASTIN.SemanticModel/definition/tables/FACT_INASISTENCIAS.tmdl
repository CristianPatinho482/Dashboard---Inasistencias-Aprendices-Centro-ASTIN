		lineageTag: 8eb87058-628d-4bee-a09d-151964107f44

	measure 'Top 10 Aprendices Programa' =
			VAR Ranking = RANKX ( ALLSELECTED ( DIM_PROGRAMA[NombrePrograma] ), [Aprendices con inasistencias], , DESC, Dense )
			RETURN IF ( NOT ISBLANK ( [Aprendices con inasistencias] ) && Ranking <= 10, [Aprendices con inasistencias] )
		formatString: #,##0
		displayFolder: 03 Aprendices
		lineageTag: d89ef706-8463-4a3e-bea2-503591a919f6

	measure 'Top 10 Índice de Riesgo Ficha' =
			VAR Universo = FILTER ( ALLSELECTED ( DIM_FICHA[FichaID] ), CALCULATE ( MAX ( DIM_FICHA[MuestraSuficiente] ) ) = 1 )
			VAR Ranking = RANKX ( Universo, [Índice de riesgo promedio de fichas], , DESC, Dense )
			RETURN IF ( CALCULATE ( MAX ( DIM_FICHA[MuestraSuficiente] ) ) = 1 && Ranking <= 10, [Índice de riesgo promedio de fichas] )
		formatString: 0.0
		displayFolder: 02 Riesgo
		lineageTag: 711cde3f-fe69-4dbf-9ced-e973da2a59c5

