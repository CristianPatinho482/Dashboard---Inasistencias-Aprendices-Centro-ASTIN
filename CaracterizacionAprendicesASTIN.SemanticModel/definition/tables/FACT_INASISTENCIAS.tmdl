			```
		formatString: 0.0%
		displayFolder: 01 Inasistencias

	measure '% inasistencias sin información' = ```
			DIVIDE ( [Inasistencias sin información], [Total inasistencias] )
			```
		formatString: 0.0%
		displayFolder: 01 Inasistencias

	measure 'Horas de retardo' = ```
			CALCULATE ( [Total horas perdidas], FACT_INASISTENCIAS[EsRetardo] = 1 )
			```
		formatString: #,##0
		displayFolder: 01 Inasistencias

	measure 'Cantidad de retardos' = ```
			CALCULATE ( [Total inasistencias], FACT_INASISTENCIAS[EsRetardo] = 1 )
			```
		formatString: #,##0
		displayFolder: 01 Inasistencias

	measure '% horas de retardo' = ```
			DIVIDE ( [Horas de retardo], [Total horas perdidas] )
			```
		formatString: 0.0%
		displayFolder: 01 Inasistencias

	measure 'Horas no justificadas por inasistencia' = ```
			DIVIDE ( [Horas no justificadas], [Inasistencias no justificadas] )
			```
		formatString: #,##0.0
		displayFolder: 01 Inasistencias

	measure 'Horas de ausencia' = ```
			CALCULATE ( [Total horas perdidas], FACT_INASISTENCIAS[EsAusencia] = 1 )
			```
		formatString: #,##0
		displayFolder: 01 Inasistencias

	measure 'Inasistencias sin retardo' = ```
			CALCULATE ( [Total inasistencias], FACT_INASISTENCIAS[EsAusencia] = 1 )
			```
		formatString: #,##0
