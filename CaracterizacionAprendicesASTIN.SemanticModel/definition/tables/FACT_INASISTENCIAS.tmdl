table FACT_INASISTENCIAS

	measure 'Total horas perdidas' = ```
			SUM ( FACT_INASISTENCIAS[CantidadHoras] )
			```
		formatString: #,##0
		displayFolder: 00 KPIs

	measure 'Total inasistencias' = ```
			COUNTROWS ( FACT_INASISTENCIAS )
			```
		formatString: #,##0
		displayFolder: 00 KPIs

	measure 'Registros válidos al corte' = ```
			CALCULATE ( COUNTROWS ( FACT_INASISTENCIAS ), REMOVEFILTERS ( FACT_INASISTENCIAS ), REMOVEFILTERS ( DIM_CALENDARIO ), REMOVEFILTERS ( DIM_APRENDIZ ), REMOVEFILTERS ( DIM_FICHA ), REMOVEFILTERS ( DIM_PROGRAMA ) )
			```
		formatString: #,##0
		displayFolder: 00 KPIs

	measure 'Fecha de corte de información' = ```
			CALCULATE ( MAX ( FACT_INASISTENCIAS[FechaFin] ), REMOVEFILTERS ( FACT_INASISTENCIAS ), REMOVEFILTERS ( DIM_CALENDARIO ), REMOVEFILTERS ( DIM_APRENDIZ ), REMOVEFILTERS ( DIM_FICHA ), REMOVEFILTERS ( DIM_PROGRAMA ) )
			```
		formatString: d mmm yyyy
		displayFolder: 00 KPIs

	measure 'Horas no justificadas en periodo' = ```
			CALCULATE ( [Total horas perdidas], FACT_INASISTENCIAS[EsNoJustificada] = 1 )
			```
		formatString: #,##0.0
		displayFolder: 03 Aprendices

	measure 'Máximo semanal horas no justificadas' = ```
			MAXX ( VALUES ( DIM_CALENDARIO[InicioSemana] ), [Horas no justificadas en periodo] )
			```
		formatString: #,##0.0
		displayFolder: 03 Aprendices

	measure 'Semáforo semanal' = ```
			VAR Horas = [Máximo semanal horas no justificadas]
			RETURN SWITCH ( TRUE (), ISBLANK ( Horas ), BLANK (), Horas < 12, UNICHAR ( 128994 ) & " Verde", Horas <= 16, UNICHAR ( 128993 ) & " Amarillo", UNICHAR ( 128308 ) & " Rojo" )
			```
		displayFolder: 03 Aprendices

	measure 'Aprendices con inasistencias' = ```
			DISTINCTCOUNT ( FACT_INASISTENCIAS[AprendizID] )
			```
		formatString: #,##0
		displayFolder: 00 KPIs

	measure 'Fichas con inasistencias' = ```
			DISTINCTCOUNT ( FACT_INASISTENCIAS[FichaID] )
			```
		formatString: #,##0
		displayFolder: 00 KPIs

	measure 'Programas con inasistencias' = ```
			DISTINCTCOUNT ( FACT_INASISTENCIAS[ProgramaID] )
			```
		formatString: #,##0
		displayFolder: 00 KPIs

	measure '% horas no justificadas' = ```
			DIVIDE ( [Horas no justificadas], [Total horas perdidas] )
			```
		formatString: 0.0%
		displayFolder: 00 KPIs

	measure '% horas justificadas' = ```
			DIVIDE ( [Horas justificadas], [Total horas perdidas] )
			```
		formatString: 0.0%
		displayFolder: 00 KPIs

	measure '% horas sin información' = ```
			DIVIDE ( [Horas sin información], [Total horas perdidas] )
			```
		formatString: 0.0%
		displayFolder: 00 KPIs

	measure 'Horas por inasistencia' = ```
			DIVIDE ( [Total horas perdidas], [Total inasistencias] )
			```
		formatString: #,##0.0
		displayFolder: 00 KPIs

	measure 'Días con inasistencias' = ```
			DISTINCTCOUNT ( FACT_INASISTENCIAS[Fecha] )
			```
		formatString: #,##0
		displayFolder: 00 KPIs

	measure 'Fichas en riesgo alto' = ```
			CALCULATE ( DISTINCTCOUNT ( FACT_INASISTENCIAS[FichaID] ), DIM_FICHA[NivelRiesgoCorte] = "Alto" )
			```
		formatString: #,##0
		displayFolder: 00 KPIs

	measure 'Programas en riesgo alto' = ```
			CALCULATE ( DISTINCTCOUNT ( FACT_INASISTENCIAS[ProgramaID] ), DIM_PROGRAMA[NivelRiesgoCorte] = "Alto" )
			```
		formatString: #,##0
		displayFolder: 00 KPIs

	measure 'Casos posible deserción' = ```
			CALCULATE ( [Aprendices con inasistencias], FACT_INASISTENCIAS[EsAlertaDesercionAprendiz] = 1 )
			```
		formatString: #,##0
		displayFolder: 00 KPIs

	measure 'Horas justificadas' = ```
			CALCULATE ( [Total horas perdidas], FACT_INASISTENCIAS[EsJustificada] = 1 )
			```
