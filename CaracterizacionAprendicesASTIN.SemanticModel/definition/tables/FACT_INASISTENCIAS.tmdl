			DIVIDE ( [Aprendices con una sola inasistencia], [Aprendices con inasistencias] )
			```
		formatString: 0.0%
		displayFolder: 03 Aprendices

	measure 'Aprendices en más de una ficha' = ```
			COUNTROWS ( FILTER ( VALUES ( FACT_INASISTENCIAS[AprendizID] ), CALCULATE ( DISTINCTCOUNT ( FACT_INASISTENCIAS[FichaID] ) ) > 1 ) )
			```
		formatString: #,##0
		displayFolder: 03 Aprendices

	measure '% aprendices en más de una ficha' = ```
			DIVIDE ( [Aprendices en más de una ficha], [Aprendices con inasistencias] )
			```
		formatString: 0.0%
		displayFolder: 03 Aprendices

	measure 'Aprendices con retardo' = ```
			CALCULATE ( [Aprendices con inasistencias], FACT_INASISTENCIAS[EsRetardo] = 1 )
			```
		formatString: #,##0
		displayFolder: 03 Aprendices

	measure '% aprendices con retardo' = ```
			DIVIDE ( [Aprendices con retardo], [Aprendices con inasistencias] )
			```
		formatString: 0.0%
		displayFolder: 03 Aprendices

	measure 'Aprendices con horas no justificadas' = ```
			CALCULATE ( [Aprendices con inasistencias], FACT_INASISTENCIAS[EsNoJustificada] = 1 )
			```
		formatString: #,##0
		displayFolder: 03 Aprendices

	measure '% aprendices con horas no justificadas' = ```
			DIVIDE ( [Aprendices con horas no justificadas], [Aprendices con inasistencias] )
			```
		formatString: 0.0%
		displayFolder: 03 Aprendices

	measure 'Horas último mes' = ```
			VAR FechaMax = CALCULATE ( MAX ( FACT_INASISTENCIAS[Fecha] ), REMOVEFILTERS ( DIM_CALENDARIO ) )
			VAR InicioMes = DATE ( YEAR ( FechaMax ), MONTH ( FechaMax ), 1 )
			RETURN CALCULATE ( [Total horas perdidas], DIM_CALENDARIO[Fecha] >= InicioMes && DIM_CALENDARIO[Fecha] <= FechaMax )
			```
		formatString: #,##0
		displayFolder: 04 Tendencias

	measure 'Horas mes anterior' = ```
			VAR FechaMax = CALCULATE ( MAX ( FACT_INASISTENCIAS[Fecha] ), REMOVEFILTERS ( DIM_CALENDARIO ) )
			VAR InicioMes = DATE ( YEAR ( FechaMax ), MONTH ( FechaMax ), 1 )
			VAR InicioAnterior = EDATE ( InicioMes, -1 )
			RETURN CALCULATE ( [Total horas perdidas], DIM_CALENDARIO[Fecha] >= InicioAnterior && DIM_CALENDARIO[Fecha] < InicioMes )
			```
		formatString: #,##0
		displayFolder: 04 Tendencias

	measure 'Variación % horas mes' = ```
			DIVIDE ( [Horas último mes] - [Horas mes anterior], [Horas mes anterior] )
			```
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 04 Tendencias

	measure 'Horas YTD' = ```
			VAR FechaMax = CALCULATE ( MAX ( FACT_INASISTENCIAS[Fecha] ), REMOVEFILTERS ( DIM_CALENDARIO ) )
			RETURN CALCULATE ( [Total horas perdidas], DATESYTD ( DIM_CALENDARIO[Fecha] ), DIM_CALENDARIO[Fecha] <= FechaMax )
			```
		formatString: #,##0
		displayFolder: 04 Tendencias

	measure 'Inasistencias último mes' = ```
			VAR FechaMax = CALCULATE ( MAX ( FACT_INASISTENCIAS[Fecha] ), REMOVEFILTERS ( DIM_CALENDARIO ) )
			VAR InicioMes = DATE ( YEAR ( FechaMax ), MONTH ( FechaMax ), 1 )
			RETURN CALCULATE ( [Total inasistencias], DIM_CALENDARIO[Fecha] >= InicioMes && DIM_CALENDARIO[Fecha] <= FechaMax )
			```
		formatString: #,##0
		displayFolder: 04 Tendencias

	measure 'Inasistencias mes anterior' = ```
			VAR FechaMax = CALCULATE ( MAX ( FACT_INASISTENCIAS[Fecha] ), REMOVEFILTERS ( DIM_CALENDARIO ) )
			VAR InicioMes = DATE ( YEAR ( FechaMax ), MONTH ( FechaMax ), 1 )
			VAR InicioAnterior = EDATE ( InicioMes, -1 )
			RETURN CALCULATE ( [Total inasistencias], DIM_CALENDARIO[Fecha] >= InicioAnterior && DIM_CALENDARIO[Fecha] < InicioMes )
			```
		formatString: #,##0
		displayFolder: 04 Tendencias

	measure 'Variación % inasistencias mes' = ```
			DIVIDE ( [Inasistencias último mes] - [Inasistencias mes anterior], [Inasistencias mes anterior] )
			```
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 04 Tendencias

	measure 'Aprendices último mes' = ```
			VAR FechaMax = CALCULATE ( MAX ( FACT_INASISTENCIAS[Fecha] ), REMOVEFILTERS ( DIM_CALENDARIO ) )
			VAR InicioMes = DATE ( YEAR ( FechaMax ), MONTH ( FechaMax ), 1 )
			RETURN CALCULATE ( [Aprendices con inasistencias], DIM_CALENDARIO[Fecha] >= InicioMes && DIM_CALENDARIO[Fecha] <= FechaMax )
			```
		formatString: #,##0
		displayFolder: 04 Tendencias

	measure 'Horas no justificadas último mes' = ```
			VAR FechaMax = CALCULATE ( MAX ( FACT_INASISTENCIAS[Fecha] ), REMOVEFILTERS ( DIM_CALENDARIO ) )
			VAR InicioMes = DATE ( YEAR ( FechaMax ), MONTH ( FechaMax ), 1 )
			RETURN CALCULATE ( [Horas no justificadas], DIM_CALENDARIO[Fecha] >= InicioMes && DIM_CALENDARIO[Fecha] <= FechaMax )
			```
		formatString: #,##0
		displayFolder: 04 Tendencias

	measure '% horas no justificadas último mes' = ```
			DIVIDE ( [Horas no justificadas último mes], [Horas último mes] )
			```
		formatString: 0.0%
		displayFolder: 04 Tendencias

	measure 'Promedio mensual de horas' = ```
			VAR Meses = FILTER ( VALUES ( DIM_CALENDARIO[AnioMes] ), CALCULATE ( [Total inasistencias] ) > 0 )
			RETURN AVERAGEX ( Meses, CALCULATE ( [Total horas perdidas] ) )
			```
		formatString: #,##0
		displayFolder: 04 Tendencias

	measure 'Mes con más horas' = ```
			VAR Meses = ADDCOLUMNS ( FILTER ( VALUES ( DIM_CALENDARIO[EtiquetaMes] ), CALCULATE ( [Total inasistencias] ) > 0 ), "@Horas", CALCULATE ( [Total horas perdidas] ) )
			RETURN MAXX ( TOPN ( 1, Meses, [@Horas], DESC ), DIM_CALENDARIO[EtiquetaMes] )
			```
		displayFolder: 04 Tendencias

	measure 'Horas del mes pico' = ```
			VAR Meses = ADDCOLUMNS ( FILTER ( VALUES ( DIM_CALENDARIO[EtiquetaMes] ), CALCULATE ( [Total inasistencias] ) > 0 ), "@Horas", CALCULATE ( [Total horas perdidas] ) )
			RETURN MAXX ( TOPN ( 1, Meses, [@Horas], DESC ), [@Horas] )
			```
		formatString: #,##0
		displayFolder: 04 Tendencias

	measure 'Promedio móvil 3 meses de horas' = ```
			VAR FechaMax = CALCULATE ( MAX ( FACT_INASISTENCIAS[Fecha] ), REMOVEFILTERS ( DIM_CALENDARIO ) )
			VAR Fin = EOMONTH ( FechaMax, 0 )
			RETURN CALCULATE ( AVERAGEX ( VALUES ( DIM_CALENDARIO[AnioMes] ), [Total horas perdidas] ), DATESINPERIOD ( DIM_CALENDARIO[Fecha], Fin, -3, MONTH ) )
			```
		formatString: #,##0
		displayFolder: 04 Tendencias

	measure 'Registros origen' = ```
			16687
			```
		formatString: #,##0
		displayFolder: 00 KPIs

	measure 'Duplicados removidos' = ```
			446
			```
		formatString: #,##0
		displayFolder: 00 KPIs

	measure '% duplicados removidos' = ```
			DIVIDE ( 446, 16687 )
			```
		formatString: 0.00%
		displayFolder: 00 KPIs

	measure 'Registros sin justificación' = ```
			CALCULATE ( COUNTROWS ( FACT_INASISTENCIAS ), ISBLANK ( FACT_INASISTENCIAS[JustificacionOriginal] ) )
			```
		formatString: #,##0
		displayFolder: 00 KPIs

	measure 'Registros no clasificados' = ```
			CALCULATE ( COUNTROWS ( FACT_INASISTENCIAS ), FACT_INASISTENCIAS[CategoriaJustificacion] = "Sin información" )
			```
		formatString: #,##0
		displayFolder: 00 KPIs

	measure 'Registros que requieren revisión' = ```
			CALCULATE ( COUNTROWS ( FACT_INASISTENCIAS ), FACT_INASISTENCIAS[RequiereRevision] = 1 )
			```
		formatString: #,##0
		displayFolder: 00 KPIs

	measure '% registros que requieren revisión' = ```
			DIVIDE ( [Registros que requieren revisión], [Total inasistencias] )
			```
		formatString: 0.0%
		displayFolder: 00 KPIs

	measure 'Registros con horas atípicas' = ```
			CALCULATE ( COUNTROWS ( FACT_INASISTENCIAS ), FACT_INASISTENCIAS[EsOutlierHoras] = 1 )
			```
		formatString: #,##0
		displayFolder: 00 KPIs

	measure 'Justificaciones únicas' = ```
			DISTINCTCOUNT ( FACT_INASISTENCIAS[JustificacionOriginal] )
			```
		formatString: #,##0
		displayFolder: 00 KPIs

	measure 'Cobertura jornada' = ```
			0
			```
		formatString: 0.0%
		displayFolder: 00 KPIs

	measure 'Cobertura modalidad' = ```
			0
			```
		formatString: 0.0%
		displayFolder: 00 KPIs

	measure 'Cobertura estado académico' = ```
			0
			```
		formatString: 0.0%
		displayFolder: 00 KPIs

	measure 'Cobertura matrícula' = ```
			0
			```
		formatString: 0.0%
		displayFolder: 00 KPIs

	measure 'Cobertura documento' = ```
			DIVIDE ( CALCULATE ( [Aprendices con inasistencias], FACT_INASISTENCIAS[TieneDocumentoAprendiz] = 1 ), [Aprendices con inasistencias] )
			```
		formatString: 0.0%
		displayFolder: 00 KPIs

	measure 'Fichas sin jornada' = ```
			CALCULATE ( DISTINCTCOUNT ( FACT_INASISTENCIAS[FichaID] ), DIM_FICHA[Jornada] = "No informada" )
			```
		formatString: #,##0
		displayFolder: 00 KPIs

	measure 'Programas sin nivel formativo' = ```
			CALCULATE ( DISTINCTCOUNT ( FACT_INASISTENCIAS[ProgramaID] ), DIM_PROGRAMA[NivelFormacion] = "No informado" )
			```
		formatString: #,##0
		displayFolder: 00 KPIs

	measure 'Fecha mínima de novedad' = ```
			MIN ( FACT_INASISTENCIAS[Fecha] )
			```
		formatString: dd/mm/yyyy
		displayFolder: 00 KPIs

	measure 'Fecha máxima de novedad' = ```
			MAX ( FACT_INASISTENCIAS[Fecha] )
			```
		formatString: dd/mm/yyyy
		displayFolder: 00 KPIs

	measure 'Días de cobertura' = ```
			DATEDIFF ( MIN ( FACT_INASISTENCIAS[Fecha] ), MAX ( FACT_INASISTENCIAS[Fecha] ), DAY ) + 1
			```
		formatString: #,##0
		displayFolder: 00 KPIs

	measure 'Top 10 Horas Ficha' = ```
			VAR Ranking = RANKX ( ALLSELECTED ( DIM_FICHA[FichaID] ), [Total horas perdidas], , DESC, Dense )
			RETURN IF ( NOT ISBLANK ( [Total horas perdidas] ) && Ranking <= 10, [Total horas perdidas] )
			```
		formatString: #,##0
		displayFolder: 01 Inasistencias

	measure 'Top 10 Horas No Justificadas Ficha' = ```
			VAR Ranking = RANKX ( ALLSELECTED ( DIM_FICHA[FichaID] ), [Horas no justificadas], , DESC, Dense )
			RETURN IF ( NOT ISBLANK ( [Horas no justificadas] ) && Ranking <= 10, [Horas no justificadas] )
			```
		formatString: #,##0
		displayFolder: 01 Inasistencias

	measure 'Top 10 Horas Programa' = ```
			VAR Ranking = RANKX ( ALLSELECTED ( DIM_PROGRAMA[NombrePrograma] ), [Total horas perdidas], , DESC, Dense )
			RETURN IF ( NOT ISBLANK ( [Total horas perdidas] ) && Ranking <= 10, [Total horas perdidas] )
			```
		formatString: #,##0
		displayFolder: 01 Inasistencias

	measure 'Top 10 Horas No Justificadas Programa' = ```
			VAR Ranking = RANKX ( ALLSELECTED ( DIM_PROGRAMA[NombrePrograma] ), [Horas no justificadas], , DESC, Dense )
			RETURN IF ( NOT ISBLANK ( [Horas no justificadas] ) && Ranking <= 10, [Horas no justificadas] )
			```
		formatString: #,##0
		displayFolder: 01 Inasistencias

	measure 'Top 10 Aprendices Programa' = ```
			VAR Ranking = RANKX ( ALLSELECTED ( DIM_PROGRAMA[NombrePrograma] ), [Aprendices con inasistencias], , DESC, Dense )
			RETURN IF ( NOT ISBLANK ( [Aprendices con inasistencias] ) && Ranking <= 10, [Aprendices con inasistencias] )
			```
		formatString: #,##0
		displayFolder: 03 Aprendices

	measure 'Top 10 Índice de Riesgo Ficha' = ```
			VAR Universo = FILTER ( ALLSELECTED ( DIM_FICHA[FichaID] ), CALCULATE ( MAX ( DIM_FICHA[MuestraSuficiente] ) ) = 1 )
			VAR Ranking = RANKX ( Universo, [Índice de riesgo promedio de fichas], , DESC, Dense )
			RETURN IF ( CALCULATE ( MAX ( DIM_FICHA[MuestraSuficiente] ) ) = 1 && Ranking <= 10, [Índice de riesgo promedio de fichas] )
			```
		formatString: 0.0
		displayFolder: 02 Riesgo

